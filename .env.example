# Copy thành .env rồi chỉnh nếu cần:
#   copy .env.example .env

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
JPA_DDL_AUTO=update
SWAGGER_ENABLED=true

KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/scanms
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8180
KEYCLOAK_REALM=scanms
KEYCLOAK_CLIENT_ID=scanms-client
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_NAME=keycloak_db
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_DB_PORT=5454

# Phải khớp secret của client "scanms-client" trong Keycloak
CLIENT_SECRET=change-me

PRODUCT_DB_NAME=product_db
PRODUCT_DB_PORT=5437
PRODUCT_SERVICE_PORT=8082

USER_DB_NAME=user_db
USER_DB_PORT=5433
USER_SERVICE_PORT=8081

ORDER_DB_NAME=order_db
ORDER_DB_PORT=5434
ORDER_SERVICE_PORT=8083

PAYMENT_DB_NAME=payment_db
PAYMENT_DB_PORT=5435
PAYMENT_SERVICE_PORT=8084

PROMOTION_DB_NAME=promotion_db
PROMOTION_DB_PORT=5436
PROMOTION_SERVICE_PORT=8085

GATEWAY_PORT=8080
AI_SERVICE_URL=http://localhost:8000
USER_SERVICE_URL=http://localhost:8081
PRODUCT_SERVICE_URL=http://localhost:8082
ORDER_SERVICE_URL=http://localhost:8083
PAYMENT_SERVICE_URL=http://localhost:8084
PROMOTION_SERVICE_URL=http://localhost:8085
FRONTEND_URL=http://localhost:5173

# Quote-only GHN sandbox; customer does not need a GHN account.
# Use FIXED until sandbox credentials below have been configured.
CHECKOUT_SHIPPING_PROVIDER=FIXED
GHN_SANDBOX_TOKEN=
GHN_SANDBOX_SHOP_ID=
GHN_SANDBOX_STORE_ID=02c1461c-aead-4366-9116-f72915bac9ce
GHN_SANDBOX_ITEM_WEIGHT_GRAMS=300
GHN_SANDBOX_PARCEL_LENGTH_CM=25
GHN_SANDBOX_PARCEL_WIDTH_CM=20
GHN_SANDBOX_PARCEL_HEIGHT_CM=8

# Must match livestream-realtime/.env; server-side only.
LIVE_METRICS_SECRET=
