APP_NAME=SCANMS AI Service
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
MODEL_PATH=weights/best.pt
CONFIDENCE_THRESHOLD=0.5
MAX_IMAGE_SIZE_MB=10
COLOR_CLUSTERS=3
COLOR_RESIZE_PIXELS=128
FASHION_CLIP_ENABLED=true
FASHION_CLIP_MODEL=patrickjohncyh/fashion-clip
# Keep true in CI/offline environments. Set false once to download and cache the model.
FASHION_CLIP_LOCAL_FILES_ONLY=true
FASHION_CLIP_DEVICE=auto
RANKING_VISUAL_WEIGHT=0.60
RANKING_STYLE_WEIGHT=0.20
RANKING_COLOR_WEIGHT=0.10
RANKING_METADATA_WEIGHT=0.10
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
